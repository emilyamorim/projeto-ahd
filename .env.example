# Variáveis de ambiente do projeto AHD
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# ATENÇÃO: nunca envie o arquivo .env para o GitHub!

# Chave secreta do Django
# Gere uma nova com o comando:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cole-sua-chave-aqui

# True no desenvolvimento, False em produção
DEBUG=True

# Hosts permitidos (não precisa mudar no desenvolvimento)
# Em produção (ex: PythonAnywhere): seunome.pythonanywhere.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para CSRF (necessário em produção com HTTPS)
# Exemplo: https://seunome.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# Banco de dados (opcional). Se não definir, usa SQLite local.
# NÃO deixe a variável vazia: ou define um valor, ou mantém comentada.
# Em produção, use a connection string do Neon/Supabase:
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# E-mail (recuperação de senha). Sem EMAIL_HOST, os e-mails aparecem só no terminal.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app
# DEFAULT_FROM_EMAIL=Ampliando Horizontes Digitais <seu-email@gmail.com>

# Armazenamento permanente das fotos (produção). Sem isso, as fotos ficam em media/.
# AWS_STORAGE_BUCKET_NAME=nome-do-bucket
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT_URL=https://<id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=fotos.seudominio.com
