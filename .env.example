# Variáveis de ambiente do projeto AHD
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# ATENÇÃO: nunca envie o arquivo .env para o GitHub!

# Chave secreta do Django
# Gere uma nova com o comando:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cole-sua-chave-aqui

# True no desenvolvimento, False em produção
DEBUG=True

# Hosts permitidos (não precisa mudar no desenvolvimento)
ALLOWED_HOSTS=localhost,127.0.0.1
